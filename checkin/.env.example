# Backend runtime configuration template.
# Copy this file to .env on the server and fill in real values there.
# Never commit real secrets.

# Server
SERVER_PORT=8080

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_checkin
DB_USER=smart_checkin_user
DB_PASSWORD=change-me
# Optional: use DB_URL to override the assembled DSN.
# DB_URL=user:password@tcp(127.0.0.1:3306)/smart_checkin?charset=utf8mb4&parseTime=True&loc=Local

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-to-a-long-random-secret
JWT_EXPIRE_HOURS=720

# Emergency super-admin bypass.
# Leave empty to disable. Configure only on a trusted server when emergency access is required.
SUPER_ADMIN_SECURE_KEY=

# WeChat mini program
WX_APPID=wx-your-appid
WX_SECRET=change-me

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Aliyun OSS
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=your-bucket
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Volcengine OCR
VOLC_OCR_AK=
VOLC_OCR_SK=
VOLC_OCR_ENDPOINT=https://visual-api.volcengineapi.com

# SM2 keys, if the deployed flow uses them.
SM2_PRIVATE_KEY=
SM2_PUBLIC_KEY=

/* 默认浅色模式 (Light Mode) 变量 */
page {
  --bg-color: #f5f7fa;
  --text-color: #121212;
  --text-muted: #666666;
  --glass-bg: rgba(255, 255, 255, 0.7);
  --glass-border: rgba(255, 255, 255, 0.8);
  --glass-shadow: rgba(0, 0, 0, 0.08);
  --input-bg: rgba(0, 0, 0, 0.05);
}

/* 监听手机系统深色模式 (Dark Mode) 自动覆盖变量 */
@media (prefers-color-scheme: dark) {
  page {
    --bg-color: #0f1015;
    --text-color: #ffffff;
    --text-muted: #aaaaaa;
    --glass-bg: rgba(255, 255, 255, 0.05);
    --glass-border: rgba(255, 255, 255, 0.1);
    --glass-shadow: rgba(0, 0, 0, 0.5);
    --input-bg: rgba(0, 0, 0, 0.2);
  }
}

/* ==================== Premium 暂未开放遮罩层设计 ==================== */
.not-open-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 9999;
  background: rgba(15, 16, 21, 0.82);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
}

.mask-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 40rpx;
  width: 80%;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.3);
}

.lock-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
  animation: floatAnim 3s ease-in-out infinite;
}

.mask-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.mask-desc {
  font-size: 26rpx;
  color: #aaaaaa;
  margin-bottom: 50rpx;
  line-height: 1.5;
  padding: 0 20rpx;
}

.back-btn {
  background: linear-gradient(135deg, #FFC107, #FF9800);
  color: #0f1015 !important;
  font-weight: bold;
  font-size: 28rpx;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  box-shadow: 0 10rpx 30rpx rgba(255, 193, 7, 0.3);
  transition: all 0.3s ease;
  line-height: 1.5;
  border: none;
}

.back-btn:active {
  transform: scale(0.95);
  box-shadow: 0 5rpx 15rpx rgba(255, 193, 7, 0.2);
}

@keyframes floatAnim {
  0% { transform: translateY(0); }
  50% { transform: translateY(-15rpx); }
  100% { transform: translateY(0); }
}
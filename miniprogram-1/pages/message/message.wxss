page {
  background-color: #e8e8e8;
  color: #333;
  padding: 30rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.title { font-size: 40rpx; font-weight: 900; color: #333; }

.read-all-btn {
  padding: 12rpx 30rpx;
  border-radius: 40rpx;
  background: #e8e8e8;
  box-shadow: 6rpx 6rpx 12rpx #c5c5c5, -6rpx -6rpx 12rpx #ffffff;
  font-size: 26rpx;
  font-weight: bold;
  color: #07c160;
  transition: 0.2s;
}
.read-all-btn:active {
  box-shadow: inset 6rpx 6rpx 12rpx #c5c5c5, inset -6rpx -6rpx 12rpx #ffffff;
}

.msg-list { display: flex; flex-direction: column; gap: 30rpx; }

.msg-card {
  position: relative;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #e8e8e8;
  box-shadow: 10rpx 10rpx 20rpx #c5c5c5, -10rpx -10rpx 20rpx #ffffff;
}

.unread-dot {
  position: absolute;
  top: 30rpx; left: 15rpx;
  width: 12rpx; height: 12rpx;
  background: #ff4757;
  border-radius: 50%;
  box-shadow: 0 0 10rpx #ff4757;
}

.msg-top {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 15rpx; padding-left: 15rpx;
}

.msg-title { font-size: 30rpx; font-weight: bold; color: #222; }
.msg-time { font-size: 24rpx; color: #888; }

.msg-content {
  font-size: 28rpx; color: #555;
  line-height: 1.6; padding-left: 15rpx;
  white-space: pre-wrap;
}

.empty-tip {
  text-align: center; color: #999;
  font-size: 28rpx; margin-top: 200rpx;
}
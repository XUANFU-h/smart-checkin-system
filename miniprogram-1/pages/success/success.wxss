page { 
  background-color: #0A0A0C; /* 调整为沉浸式深色底，让光球更酷炫 */
  height: 100vh; 
  overflow: hidden; 
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; 
}

.success-page { position: relative; height: 100%; display: flex; align-items: center; justify-content: center; }

/* 动态光球背景 */
.bg-orbs { position: absolute; inset: 0; pointer-events: none; overflow: hidden; z-index: 0; }
.orb { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.4; }
.orb-g1 { width: 560rpx; height: 560rpx; background: #07c160; top: -100rpx; right: -100rpx; animation: float 7s ease-in-out infinite; }
.orb-g2 { width: 440rpx; height: 440rpx; background: #1e90ff; bottom: 5%; left: -80rpx; animation: float 9s ease-in-out infinite reverse; }

@keyframes float {
  0% { transform: translateY(0) rotate(0); }
  50% { transform: translateY(40rpx) rotate(180deg); }
  100% { transform: translateY(0) rotate(360deg); }
}

.success-content { position: relative; z-index: 1; display: flex; flex-direction: column; justify-content: space-between; align-items: center; width: 100%; height: 88%; padding: 0 40rpx; box-sizing: border-box; }

/* 顶部 */
.top-section { display: flex; flex-direction: column; align-items: center; }
.success-icon { width: 280rpx; height: 280rpx; margin-bottom: 20rpx; filter: drop-shadow(0 10rpx 20rpx rgba(7,193,96,0.4));}
.pulse-anim { animation: heartPulse 2s infinite; }
@keyframes heartPulse { 0% { transform: scale(1); } 50% { transform: scale(1.05); } 100% { transform: scale(1); } }
.success-title { font-size: 52rpx; font-weight: 900; color: #fff; letter-spacing: 4rpx; text-shadow: 0 4rpx 10rpx rgba(0,0,0,0.5);}

/* 抽奖区 */
.lottery-section { width: 100%; display: flex; flex-direction: column; align-items: center; gap: 40rpx; margin: 40rpx 0; }
.slot-machine { width: 100%; height: 160rpx; border-radius: 30rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid rgba(255,215,0,0.3); transition: 0.3s;}
.rolling-glow { box-shadow: 0 0 40rpx rgba(255,215,0,0.4); border-color: #FFD700; }

.roller { width: 100%; height: 100%; text-align: center; }
.roller-text { font-size: 46rpx; font-weight: 900; color: #FFD700; line-height: 160rpx; }
.blur-text { filter: blur(2px); opacity: 0.8; }
.roller-static { text-align: center; width: 100%; }
.result-text { font-size: 34rpx; color: #ccc; font-weight: bold; letter-spacing: 2rpx;}
.highlight { font-size: 50rpx; color: #FFD700; font-weight: 900; text-shadow: 0 0 20rpx rgba(255,215,0,0.6); }

.try-btn { background: linear-gradient(135deg, #FFD700, #FFA500); color: #8B4500 !important; border-radius: 50rpx; width: 80%; height: 100rpx; display: flex; justify-content: center; align-items: center; font-size: 34rpx; font-weight: 900; box-shadow: 0 10rpx 30rpx rgba(255,215,0,0.3); }
.try-btn.disabled { background: rgba(255,255,255,0.1); color: #888 !important; box-shadow: none; pointer-events: none; }
.bouncing-btn { animation: bounce 2s infinite; }
@keyframes bounce { 0%, 20%, 50%, 80%, 100% {transform: translateY(0);} 40% {transform: translateY(-15rpx);} 60% {transform: translateY(-8rpx);} }

/* 底部与通用卡片 */
.bottom-section { width: 100%; display: flex; flex-direction: column; gap: 30rpx; }
.glass-card { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 2rpx solid rgba(255, 255, 255, 0.1); box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.3); }
.quote-card { width: 100%; border-radius: 24rpx; overflow: hidden; }
.quote-inner { padding: 40rpx; text-align: center; }
.quote-text { font-size: 30rpx; color: #eee; line-height: 1.7; margin-bottom: 20rpx; font-weight: bold; font-family: 'SimSun', serif; }
.quote-author { font-size: 26rpx; color: #aaa; font-weight: bold; }
.btn-go-back { background: transparent; color: #aaa; border-radius: 50rpx; width: 100%; height: 90rpx; display: flex; justify-content: center; align-items: center; font-size: 30rpx; border: 2rpx solid #555; }

/* 弹窗 */
.modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.8); display: flex; align-items: center; justify-content: center; opacity: 0; visibility: hidden; transition: 0.3s; z-index: 1000; backdrop-filter: blur(10px); }
.modal-overlay.show { opacity: 1; visibility: visible; }
.prize-box { width: 80%; padding: 60rpx 40rpx; text-align: center; border-radius: 30rpx; background: rgba(30,30,30,0.9); animation: popUp 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.27); }
@keyframes popUp { 0% { transform: scale(0.8); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
.prize-icon { font-size: 100rpx; margin-bottom: 20rpx; }
.prize-title { font-size: 32rpx; font-weight: bold; color: #fff; margin-bottom: 20rpx; }
.prize-name { font-size: 50rpx; font-weight: 900; color: #FFD700; margin-bottom: 30rpx; background: rgba(255, 215, 0, 0.1); padding: 15rpx 30rpx; border-radius: 16rpx; display: inline-block; }
.prize-desc { font-size: 26rpx; color: #aaa; line-height: 1.6; margin-bottom: 50rpx; }
.prize-btn { background: linear-gradient(135deg, #07c160, #20bf55); color: #fff; border-radius: 50rpx; height: 80rpx; line-height: 80rpx; font-size: 30rpx; font-weight: bold; width: 80%; }
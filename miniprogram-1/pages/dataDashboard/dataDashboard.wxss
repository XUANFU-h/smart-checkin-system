page {
  background-image: linear-gradient(135deg, #0A0A0C 0%, #1A1A1E 100%);
  color: #fff;
  padding: 30rpx;
  box-sizing: border-box;
  height: 100vh;
}
.container { height: 100%; display: flex; flex-direction: column; }

/* 💡 严格遵循工业级液态玻璃的嵌套参数 */
.glass-card {
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(30px);
  -webkit-backdrop-filter: blur(30px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 20px; /* 外层 20px */
  padding: 4px;        /* 安全内边距 4px */
  margin-bottom: 30rpx;
  box-shadow: 0 10px 30px rgba(0,0,0,0.5);
}

.glass-inner {
  background: rgba(0, 0, 0, 0.2);
  border-radius: 16px; /* 内层 16px */
  border: 1px solid rgba(255, 255, 255, 0.03);
}

.assets-board {
  display: flex; justify-content: space-around;
  padding: 40rpx 0;
}
.asset-item { text-align: center; }
.value { font-size: 50rpx; font-weight: 900; margin-bottom: 10rpx; font-family: monospace;}
.value.emp { color: #E6A23C; text-shadow: 0 0 20rpx rgba(230,162,60,0.4);}
.value.moral { color: #07c160; text-shadow: 0 0 20rpx rgba(7,193,96,0.4);}
.value.card { color: #00d9ff; text-shadow: 0 0 20rpx rgba(0,217,255,0.4);}
.label { font-size: 24rpx; color: #888; font-weight: bold;}

.rank-tabs-scroll { width: 100%; margin-bottom: 30rpx; flex-shrink: 0; }
.rank-tabs { display: flex; gap: 20rpx; white-space: nowrap; }
.tab {
  display: inline-block; text-align: center; padding: 20rpx 40rpx;
  border-radius: 16px; font-size: 26rpx; font-weight: bold; color: #888;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.05);
  transition: 0.3s;
}
.tab.active {
  color: #fff;
  background: rgba(7, 193, 96, 0.15);
  border-color: rgba(7, 193, 96, 0.4);
  box-shadow: 0 0 20rpx rgba(7, 193, 96, 0.2);
}

.flex-rank { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
.rank-list { flex: 1; display: flex; flex-direction: column; padding: 30rpx; overflow: hidden; }
.rank-header {
  display: flex; padding-bottom: 20rpx; border-bottom: 1px dashed rgba(255,255,255,0.1);
  font-size: 24rpx; color: #666; font-weight: bold; align-items: center;
}
.th-rank { width: 100rpx; text-align: center; }
.th-name { flex: 1; text-align: left; padding-left: 20rpx; }
.th-class { flex: 1; text-align: left; }
.th-score { width: 130rpx; text-align: right; }

.rank-scroll { flex: 1; margin-top: 20rpx; height: 100%; }
.rank-item { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1px solid rgba(255,255,255,0.03); }
.td-rank { width: 100rpx; text-align: center; font-size: 32rpx; font-weight: 900; font-style: italic; color: #555;}
.num-1 { font-size: 44rpx; text-shadow: 0 0 20rpx rgba(255,215,0,0.5);}
.num-2 { font-size: 38rpx; }
.num-3 { font-size: 34rpx; }
.td-name { flex: 1; font-size: 28rpx; color: #ddd; padding-left: 20rpx; font-weight: bold;}
.td-class { flex: 1; font-size: 22rpx; color: #666; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;}
.td-score { width: 130rpx; text-align: right; color: #07c160; font-weight: 900; font-size: 32rpx; font-family: monospace;}

.empty-state { text-align: center; padding-top: 100rpx; color: #555; font-size: 26rpx; font-style: italic;}
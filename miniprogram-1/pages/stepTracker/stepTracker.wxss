/* ================= 浅色模式主题 (默认) ================= */
page { 
  --page-bg: #f5f6fa;
  --panel-bg: rgba(255, 255, 255, 0.85);
  --text-main: #333333;
  --text-sub: #777777;
  --border-color: rgba(0, 0, 0, 0.08);
  --panel-shadow: 0 8rpx 30rpx rgba(0,0,0,0.06);
  
  height: 100vh; 
  overflow: hidden; 
  background-color: var(--page-bg);
}

/* ================= 深色模式主题 (跟随系统自动切换) ================= */
@media (prefers-color-scheme: dark) {
  page {
    --page-bg: #121212;
    --panel-bg: rgba(30, 30, 30, 0.85);
    --text-main: #ffffff;
    --text-sub: #aaaaaa;
    --border-color: rgba(255, 255, 255, 0.1);
    --panel-shadow: 0 10rpx 40rpx rgba(0,0,0,0.6);
  }
}

.tracker-container { height: 100vh; width: 100vw; display: flex; flex-direction: column; }

.map-wrap { flex: 1; position: relative; width: 100%; display: flex; }
.sport-map { width: 100%; height: 100%; }

.locate-btn {
  position: absolute; right: 40rpx; bottom: 40rpx; width: 80rpx; height: 80rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; font-size: 36rpx; 
  box-shadow: var(--panel-shadow); z-index: 100; background: var(--panel-bg); border: 1px solid var(--border-color);
}

.data-dashboard { 
  position: absolute; top: 8%; left: 5%; width: 90%; display: flex; justify-content: space-around; 
  padding: 30rpx 10rpx; border-radius: 24rpx; z-index: 10; box-sizing: border-box;
}

.glass-effect { 
  background: var(--panel-bg); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border-color); box-shadow: var(--panel-shadow); 
}

.data-item { display: flex; flex-direction: column; align-items: center; flex: 1;}
/* 字体稍微调小一点，防止 4 个数据挤在一起 */
.data-val { font-size: 38rpx; font-weight: bold; color: var(--text-main); font-family: monospace;}
.data-label { font-size: 22rpx; color: var(--text-sub); margin-top: 8rpx;}

.control-panel { 
  height: 320rpx; background: var(--page-bg); display: flex; flex-direction: column; 
  align-items: center; justify-content: center; border-top-left-radius: 40rpx; border-top-right-radius: 40rpx;
  border-top: 1px solid var(--border-color); box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05); z-index: 10; 
}

.main-btn-wrap { position: relative; width: 220rpx; height: 220rpx; display: flex; justify-content: center; align-items: center; }
.progress-ring { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border-radius: 50%; z-index: 1; transition: background 0.1s; background: conic-gradient(#07c160 var(--p, 0%), transparent 0); }

.btn-core {
  position: relative; width: 190rpx; height: 190rpx; border-radius: 50%; display: flex; flex-direction: column; 
  justify-content: center; align-items: center; z-index: 2; color: #fff; font-weight: bold; 
  box-shadow: 0 5rpx 15rpx rgba(0,0,0,0.3); transition: background 0.3s, transform 0.2s;
}
.btn-core:active { transform: scale(0.95); }

.btn-core.idle { background: linear-gradient(135deg, #07c160, #34e89e); }
.btn-core.running { background: linear-gradient(135deg, #F56C6C, #e74c3c); }
.btn-core.finished { background: linear-gradient(135deg, #E6A23C, #FFD700); }

.btn-txt { font-size: 48rpx; letter-spacing: 2rpx;}
.btn-sub { font-size: 22rpx; opacity: 0.9; margin-top: 8rpx; font-weight: normal;}
<view class="login-page">
<view class="container">
  <view class="header-area move-up">
    <image class="quantum-logo" src="/assets/logo.png" mode="aspectFit"></image>
    <view class="splash-title-zh">设置新密码</view>
    <view class="form-desc">请为您当前绑定的账号设置新的登录密码</view>
  </view>

  <view class="login-card glass-effect fade-in">
    <input type="password" class="neu-input" placeholder="新密码" placeholder-class="placeholder-color" value="{{password}}" bindinput="handleInput" data-field="password" autocomplete="off" />

    <input type="password" class="neu-input" placeholder="确认新密码" placeholder-class="placeholder-color" value="{{confirmPassword}}" bindinput="handleInput" data-field="confirmPassword" autocomplete="off" />

    <button class="submit-btn {{isSubmitting ? 'submitting' : ''}}" bindtap="submitReset">
      <block wx:if="{{isSubmitting}}">
        <view class="btn-dot-loader"><text></text><text></text><text></text></view>
      </block>
      <block wx:else>确认重置</block>
    </button>
  </view>
</view>
</view>
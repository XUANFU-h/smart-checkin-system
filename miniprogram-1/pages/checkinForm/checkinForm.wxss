page { 
  background-image: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%); 
  min-height: 100vh; 
}

.form-page { padding-bottom: 80rpx; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }

.sub-header { padding: 40rpx 40rpx 20rpx; display: flex; align-items: center; gap: 30rpx; }
.back-btn { background: #fff; border: 2rpx solid #ddd; padding: 12rpx 28rpx; border-radius: 100rpx; font-size: 26rpx; font-weight: bold; color: #333; }
.sub-title { font-size: 38rpx; font-weight: 900; color: #333; }

.page-content { padding: 0 40rpx; }

.glass-effect { background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(20px); border: 2rpx solid rgba(255, 255, 255, 0.6); border-radius: 40rpx; }
.form-card { padding: 40rpx; margin-bottom: 40rpx; box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.05); }

.info-module { background: #fff; padding: 30rpx; border-radius: 24rpx; margin-bottom: 40rpx; border: 2rpx solid rgba(0,0,0,0.06); }
.info-row { display: flex; justify-content: space-between; margin-bottom: 16rpx; font-size: 28rpx; }
.info-row:last-child { margin-bottom: 0; }
.label { color: #888; font-weight: bold; }
.value { color: #333; font-weight: 900; }
.time-text { color: #07c160; font-family: monospace; }

.module-box { margin-bottom: 40rpx; }
.area-title { font-size: 30rpx; color: #E6A23C; font-weight: 900; margin-bottom: 24rpx; }

.picker-box { background: #fff; border-radius: 16rpx; border: 2rpx solid rgba(0,0,0,0.06); padding: 0 30rpx; height: 100rpx; display: flex; align-items: center; }
.picker-box.disabled { background: #eef1f6; opacity: 0.8; cursor: not-allowed; border-color: rgba(0,0,0,0.04); }
.select-value { font-size: 28rpx; color: #333; font-weight: bold; }
.picker-box.disabled .select-value { color: #888; }

.custom-input { width: 100%; background: #fff; padding: 0 30rpx; height: 100rpx; border-radius: 16rpx; color: #333; font-size: 28rpx; border: 2rpx solid rgba(0,0,0,0.06); box-sizing: border-box; font-weight: bold; }

.img-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.img-item { width: 180rpx; height: 180rpx; border-radius: 16rpx; position: relative; overflow: hidden; border: 2rpx solid rgba(0,0,0,0.06); }
.img-item image { width: 100%; height: 100%; }
.del-btn { position: absolute; top: 0; right: 0; background: rgba(0,0,0,0.6); color: #fff; width: 48rpx; height: 48rpx; text-align: center; line-height: 44rpx; border-bottom-left-radius: 16rpx; font-size: 36rpx; font-weight: bold;}
.add-btn { width: 180rpx; height: 180rpx; border-radius: 16rpx; background: #fff; border: 4rpx dashed #ccc; display: flex; justify-content: center; align-items: center; font-size: 80rpx; color: #ccc; box-sizing: border-box;}

.file-upload { display: flex; flex-direction: column; gap: 20rpx; }
.add-file-btn { background: #fff; padding: 40rpx; text-align: center; border-radius: 16rpx; color: #999; border: 4rpx dashed #ccc; font-weight: bold; font-size: 28rpx; }
.file-item { background: rgba(7,193,96,0.1); padding: 30rpx; border-radius: 16rpx; display: flex; justify-content: space-between; align-items: center; border: 2rpx solid rgba(7,193,96,0.3); }
.file-name { color: #07c160; font-size: 28rpx; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: bold; }
.del-btn-file { font-size: 40rpx; color: #07c160; padding-left: 20rpx; font-weight: bold;}

.submit-btn { background: #07c160; color: #fff; border-radius: 100rpx; font-weight: 900; width: 100%; height: 100rpx; display: flex; justify-content: center; align-items: center; font-size: 32rpx; padding: 0; border: none; box-shadow: 0 8rpx 24rpx rgba(7,193,96,0.3); margin-top: 40rpx;}
.submit-btn:active { transform: scale(0.98); opacity: 0.9; }
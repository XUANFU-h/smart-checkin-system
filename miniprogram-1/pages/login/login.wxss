page { height: 100vh; overflow: hidden; }

.login-page {
  position: relative; width: 100%; height: 100vh; overflow-y: auto; overflow-x: hidden;
  background-image: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%);
  -webkit-overflow-scrolling: touch;
}

.container {
  display: flex; flex-direction: column; align-items: center;
  min-height: 100vh; padding: 0 10%; box-sizing: border-box; padding-bottom: 160rpx;
}

.splash-footer-fixed {
  position: fixed; bottom: 40rpx; left: 0; width: 100%; text-align: center;
  font-family: 'KaiTi', 'STKaiti', serif; color: rgba(0, 0, 0, 0.25);
  font-size: 26rpx; letter-spacing: 6rpx; pointer-events: none; z-index: 9;
  animation: fadeIn 1.2s ease;
}

.header-area {
  display: flex; flex-direction: column; align-items: center;
  transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
}
.header-area.center-stage { transform: translateY(320rpx); }
.header-area.move-up { transform: translateY(40rpx); }

.quantum-logo { width: 260rpx; height: 260rpx; margin-bottom: 30rpx; animation: quantumFadeIn 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
.splash-title-zh { font-family: 'KaiTi', 'STKaiti', serif; color: #2c3e50; font-size: 50rpx; font-weight: 900; letter-spacing: 8rpx; margin-bottom: 16rpx; animation: unfoldCenter 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
.splash-title-en { font-family: sans-serif; color: #7f8c8d; font-weight: bold; font-size: 24rpx; letter-spacing: 4rpx; animation: unfoldCenter 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; animation-delay: 0.2s; opacity: 0; }

.login-card {
  width: 100%; padding: 50rpx 40rpx; border-radius: 40rpx; margin-top: 60rpx;
  opacity: 0; transform: translateY(40rpx); z-index: 10; box-sizing: border-box;
}
.login-card.fade-in { animation: slideInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

.glass-effect {
  background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  border: 2rpx solid rgba(255, 255, 255, 0.8); box-shadow: 0 20rpx 50rpx rgba(31, 38, 135, 0.06);
}

.form-title { text-align: center; font-size: 36rpx; color: #2c3e50; font-weight: 900; margin-bottom: 12rpx; }
.form-desc { text-align: center; font-size: 22rpx; color: #7f8c8d; margin-bottom: 36rpx; }

/* 🌟 全新新拟态 (Neumorphism) 输入框核心 CSS */
.neu-input {
  border: none;
  padding: 0 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 32rpx;
  background: #e8e8e8;
  box-shadow: 12rpx 12rpx 24rpx #c5c5c5, -12rpx -12rpx 24rpx #ffffff;
  transition: 0.3s;
  width: 100%;
  box-sizing: border-box;
  color: #333;
  margin-bottom: 36rpx;
  font-size: 28rpx;
}
.neu-input:focus, .neu-input.active {
  outline-color: #e8e8e8;
  background: #e8e8e8;
  box-shadow: inset 12rpx 12rpx 24rpx #c5c5c5, inset -12rpx -12rpx 24rpx #ffffff;
  transition: 0.3s;
}

.placeholder-color { color: #999; }
.pseudo-input { position: relative; }
.arrow-down-new { position: absolute; right: 32rpx; top: 42rpx; width: 0; height: 0; border-left: 10rpx solid transparent; border-right: 10rpx solid transparent; border-top: 12rpx solid #b2bec3; }

.captcha-row { display: flex; gap: 20rpx; width: 100%; }
.captcha-group { flex: 1; margin-bottom: 0; }
.captcha-group .neu-input { margin-bottom: 0; }
.captcha-box { width: 220rpx; height: 96rpx; border-radius: 32rpx; border: none; background: #e8e8e8; box-shadow: 12rpx 12rpx 24rpx #c5c5c5, -12rpx -12rpx 24rpx #ffffff; overflow: hidden; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.captcha-img { width: 100%; height: 100%; }
.captcha-placeholder { font-size: 24rpx; color: #999; }

.submit-btn { display: flex; align-items: center; justify-content: center; width: 100%; height: 92rpx; background: #07c160; color: #fff; border-radius: 46rpx; font-weight: bold; font-size: 32rpx; margin-top: 40rpx; box-shadow: 0 10rpx 24rpx rgba(7, 193, 96, 0.2); transition: all 0.2s; }
.submit-btn:active { transform: scale(0.97); opacity: 0.9; }
.submit-btn.submitting { background: #05a050; opacity: 0.8; }

.auth-links { display: flex; justify-content: center; align-items: center; margin-top: 36rpx; font-size: 24rpx; color: #7f8c8d; }
.auth-links .divider { margin: 0 20rpx; color: #dcdde1; }

.quick-login-box { display: flex; flex-direction: column; align-items: center; margin: 30rpx 0; }
.quick-avatar { width: 160rpx; height: 160rpx; border-radius: 50%; border: 6rpx solid #fff; box-shadow: 0 10rpx 24rpx rgba(0,0,0,0.08); margin-bottom: 20rpx; }
.quick-name { font-size: 40rpx; font-weight: 900; color: #2c3e50; margin-bottom: 8rpx; }
.quick-tip { font-size: 24rpx; color: #07c160; font-weight: bold; }
.switch-account { text-align: center; font-size: 24rpx; color: #7f8c8d; text-decoration: underline; margin-top: 26rpx; }

/* 选择器底部弹窗保持原样 */
.picker-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 999; display: flex; align-items: flex-end; opacity: 0; pointer-events: none; transition: opacity 0.3s; }
.picker-overlay.show { opacity: 1; pointer-events: auto; }
.picker-content { width: 100%; background: #fff; border-radius: 40rpx 40rpx 0 0; display: flex; flex-direction: column; max-height: 55vh; transform: translateY(100%); transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1); padding-bottom: env(safe-area-inset-bottom); }
.picker-overlay.show .picker-content { transform: translateY(0); }
.picker-header { display: flex; justify-content: space-between; align-items: center; padding: 32rpx 40rpx; border-bottom: 2rpx solid #f5f6fa; }
.picker-title { font-weight: bold; font-size: 32rpx; color: #2c3e50; }
.picker-close { font-size: 48rpx; color: #b2bec3; line-height: 1; padding: 0 20rpx;}
.picker-list { overflow-y: auto; padding: 10rpx 0; }
.picker-item { padding: 30rpx 50rpx; font-size: 28rpx; color: #2c3e50; border-bottom: 2rpx solid #fbfbfc; }
.picker-item:active { background: #f5f6fa; }
.picker-item.is-active { color: #07c160; font-weight: bold; background: rgba(7, 193, 96, 0.04); }

.btn-dot-loader { display: inline-flex; align-items: center; gap: 10rpx; }
.btn-dot-loader text { display: block; width: 12rpx; height: 12rpx; border-radius: 50%; background: #fff; animation: dotBounce 1.2s ease-in-out infinite; }
.btn-dot-loader text:nth-child(1) { animation-delay: 0s; }
.btn-dot-loader text:nth-child(2) { animation-delay: 0.2s; }
.btn-dot-loader text:nth-child(3) { animation-delay: 0.4s; }

@keyframes quantumFadeIn { 0% { transform: scale(0.3); opacity: 0; filter: blur(10px); } 100% { transform: scale(1); opacity: 1; filter: blur(0px); } }
@keyframes unfoldCenter { 0% { clip-path: inset(0 50% 0 50%); opacity: 0; } 100% { clip-path: inset(0 0 0 0); opacity: 1; } }
@keyframes slideInUp { from { opacity: 0; transform: translateY(60rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes dotBounce { 0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; } 40% { transform: scale(1.2); opacity: 1; } }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
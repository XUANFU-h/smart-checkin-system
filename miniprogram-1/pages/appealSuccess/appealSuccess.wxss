page { 
  background-color: var(--bg-color, #f4f4f4); 
  padding: 40rpx; 
  box-sizing: border-box; 
  display: flex; 
  flex-direction: column; 
  justify-content: center; 
  height: 100vh; 
}

.heavy-text { 
  color: #000 !important; 
  font-weight: 900 !important; 
  font-family: 'SimSun', '宋体', serif !important; 
}

.glass-effect { 
  background: #fff; 
  border: 4rpx solid #000; 
  border-radius: 20rpx; 
  padding: 60rpx 40rpx; 
  box-shadow: 10rpx 10rpx 0 #000; 
  text-align: center; 
  margin-bottom: 60rpx;
}

.success-title { 
  font-size: 46rpx; 
  margin: 40rpx 0 20rpx 0; 
  letter-spacing: 2rpx;
}

.success-desc { 
  font-size: 30rpx; 
  color: #333 !important; 
  line-height: 1.8;
}

.back-btn { 
  background: #000; 
  color: #fff !important; 
  border-radius: 50rpx; 
  width: 100%; 
  height: 90rpx; 
  display: flex; 
  justify-content: center; 
  align-items: center; 
  font-size: 34rpx; 
  box-shadow: 0 10rpx 20rpx rgba(0,0,0,0.3);
}

.back-btn:active { 
  transform: scale(0.98); 
}
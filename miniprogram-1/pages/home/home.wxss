page { 
  background-image: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%);
  color: #333; 
  padding: 30rpx; 
  box-sizing: border-box; 
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  min-height: 100vh;
}

.container { height: 100%; display: flex; flex-direction: column;}

.glass-effect {
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 32rpx rgba(31, 38, 135, 0.05);
}

/* 🌟 全新顶级数据看板 */
.top-dashboard { display: flex; gap: 20rpx; margin-bottom: 40rpx; align-items: stretch; }

.data-card { 
  flex: 1; border-radius: 30rpx; padding: 30rpx; 
  display: flex; flex-direction: column; justify-content: space-between;
  transition: transform 0.2s;
}
.data-card:active { transform: scale(0.98); }
.card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx;}
.card-title { font-size: 28rpx; font-weight: 900; color: #2c3e50; }
.card-header .arrow { color: #aaa; font-size: 28rpx; }

.card-content { display: flex; justify-content: space-between; align-items: center; }
.data-item { display: flex; flex-direction: column; gap: 10rpx;}
.data-label { font-size: 24rpx; color: #7f8c8d; }
.data-value { font-size: 36rpx; font-weight: 900; color: #333; font-family: monospace;}
.text-green { color: #07c160; }
.highlight-rank { color: #FF4757; font-size: 44rpx; text-shadow: 0 4rpx 10rpx rgba(255, 71, 87, 0.2);}

.right-actions { display: flex; flex-direction: column; gap: 16rpx; width: 120rpx; }
.bell-btn { width: 100%; height: 90rpx; border-radius: 25rpx; display: flex; justify-content: center; align-items: center; position: relative; transition: 0.2s; }
.bell-btn:active { transform: scale(0.95); background: rgba(255, 255, 255, 0.8); }
.icon-bell { width: 42rpx; height: 42rpx; background-size: contain; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 1024 1024' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M921.6 880.64h-819.2A51.2 51.2 0 0 1 51.2 829.44v-66.56A107.7248 107.7248 0 0 1 158.72 655.36a30.72 30.72 0 0 0 30.72-30.72V376.832A319.6928 319.6928 0 0 1 399.36 78.2336a112.0256 112.0256 0 0 1 213.6064 0A319.6928 319.6928 0 0 1 824.32 376.832v247.808a30.72 30.72 0 0 0 30.72 30.72h10.24A107.7248 107.7248 0 0 1 972.8 762.88v66.56a51.2 51.2 0 0 1-51.2 51.2zM112.64 819.2h798.72v-56.32A46.08 46.08 0 0 0 865.28 716.8h-10.24a92.16 92.16 0 0 1-92.16-92.16V376.832a257.8432 257.8432 0 0 0-184.32-245.76l-19.0464-5.7344-2.6624-20.48a50.7904 50.7904 0 0 0-100.7616 0l-2.6624 20.48-19.0464 5.7344a257.8432 257.8432 0 0 0-184.32 245.76v247.808A92.16 92.16 0 0 1 158.72 716.8 46.08 46.08 0 0 0 112.64 762.88z' fill='%23555555'/%3E%3Cpath d='M665.6 353.6896a30.72 30.72 0 0 1-25.6-13.9264A259.4816 259.4816 0 0 0 542.72 251.904a30.72 30.72 0 0 1 28.2624-54.4768 320.9216 320.9216 0 0 1 120.6272 108.7488A30.72 30.72 0 0 1 665.6 353.6896z' fill='%233399FF'/%3E%3C/svg%3E"); }
.badge { position: absolute; top: -4rpx; right: -4rpx; background: #ff4757; color: #fff; font-size: 20rpx; font-weight: bold; padding: 4rpx 12rpx; border-radius: 20rpx; border: 4rpx solid #fff; box-shadow: 0 4rpx 8rpx rgba(255, 71, 87, 0.4); }

.score-capsule { flex: 1; border-radius: 40rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 15rpx 0;}
.capsule-title { font-size: 20rpx; color: #888; margin-bottom: 8rpx; font-weight: bold;}
.capsule-item { font-size: 24rpx; font-weight: 900; margin: 4rpx 0;}
.capsule-item.empower { color: #07c160; }
.capsule-item.moral { color: #1389eb; }

/* 悬赏榜 */
.bounty-section { margin-bottom: 40rpx; }
.section-title { font-size: 32rpx; font-weight: 800; margin-bottom: 25rpx; color: #2c3e50;}
.bounty-board { width: 100%; height: 400rpx; border-radius: 30rpx; padding: 20rpx; box-sizing: border-box; }
.bounty-table { display: flex; flex-direction: column; width: 100%; height: 100%; }
.table-header { display: flex; align-items: center; padding-bottom: 15rpx; border-bottom: 1px solid rgba(0,0,0,0.05); margin-bottom: 10rpx; }
.th { font-size: 24rpx; font-weight: bold; color: #888; text-align: center;}
.table-body { flex: 1; width: 100%; overflow-y: auto;}
.tr { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 1px dashed rgba(0,0,0,0.04);}
.tr:last-child { border-bottom: none; }
.td { font-size: 24rpx; color: #333; text-align: center; word-break: break-all;}
.col-id { width: 12%; display: flex; justify-content: center;}
.index-badge { background: rgba(0,0,0,0.05); color: #666; font-size: 20rpx; font-weight: bold; padding: 4rpx 14rpx; border-radius: 12rpx; }
.col-title { width: 40%; text-align: left; padding-left: 10rpx; font-weight: bold; color: #2c3e50;}
.col-score { width: 20%; color: #07c160; font-weight: 900; font-size: 26rpx;}
.col-time { width: 28%; font-size: 22rpx; color: #999;}
.empty-table-tip { text-align: center; color: #aaa; font-size: 24rpx; padding-top: 60rpx; }

/* 社区模块 */
.circle-tabs { width: 100%; white-space: nowrap; margin-bottom: 40rpx; }
.tab-item { display: inline-block; padding: 16rpx 36rpx; border-radius: 40rpx; font-size: 26rpx; color: #666; margin-right: 20rpx; transition: 0.3s; }
.tab-item.active { background: #07c160; color: #fff; font-weight: bold; border-color: #07c160; box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.3); }

.post-feed { display: flex; flex-direction: column; gap: 30rpx; }
.task { padding: 35rpx; border-radius: 24rpx; margin-bottom: 10rpx; }
.tags { width: 100%; display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx;}
.author-box { display: flex; align-items: center; gap: 20rpx;}
.author-avatar { width: 75rpx; height: 75rpx; border-radius: 50%; background: #eee; border: 2rpx solid rgba(0,0,0,0.05); }
.author-info { display: flex; flex-direction: column; justify-content: center;}
.author-name-row { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap;}
.author-name { font-size: 28rpx; font-weight: bold; color: #2c3e50;}
.official-tag { background: linear-gradient(135deg, #1389eb, #00c6ff); color: #fff; font-size: 18rpx; padding: 4rpx 12rpx; border-radius: 8rpx; font-weight: bold;}
.top-tag { background: #FF4757; color: #fff; font-size: 18rpx; padding: 4rpx 12rpx; border-radius: 8rpx; font-weight: bold;}
.stats { color: #999; font-size: 22rpx; margin-top: 4rpx;}
.post-title { font-size: 30rpx; font-weight: bold; color: #303133; margin-bottom: 15rpx; line-height: 1.4;}
.post-text { font-size: 28rpx; line-height: 1.6; margin-bottom: 25rpx; display: block; word-break: break-all; color: #444; text-align: justify;}
.post-image { width: 100%; max-height: 380rpx; border-radius: 16rpx; border: 1px solid rgba(0,0,0,0.05); box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);}
.admin-comment-block { background: rgba(19, 137, 235, 0.05); border-left: 6rpx solid #1389eb; padding: 20rpx 25rpx; border-radius: 0 12rpx 12rpx 0; margin-top: 20rpx;}
.comment-title { font-size: 24rpx; font-weight: bold; color: #1389eb; margin-bottom: 8rpx;}
.comment-text { font-size: 26rpx; color: #555; line-height: 1.5;}
.empty-tip { text-align: center; color: #aaa; font-size: 28rpx; margin-top: 80rpx; font-style: italic;}
.channel-header { display: flex; align-items: center; margin-bottom: 40rpx; gap: 20rpx; }

/* 互动栏 */
.interaction-bar { display: flex; justify-content: flex-end; gap: 40rpx; margin-top: 25rpx; border-top: 1px solid rgba(0,0,0,0.05); padding-top: 20rpx; }
.action-btn { display: flex; align-items: center; gap: 10rpx; color: #888; font-size: 26rpx; }
.action-icon { width: 40rpx; height: 40rpx; transition: 0.2s; }
@keyframes likePop { 0% { transform: scale(1); } 50% { transform: scale(1.4) rotate(-10deg); } 100% { transform: scale(1); } }
.liked-anim { animation: likePop 0.4s ease-out; }

/* 弹窗 */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 999; display: flex; justify-content: center; align-items: center; backdrop-filter: blur(5px); }
.modal-content { width: 85%; background: #fff; border-radius: 30rpx; padding: 40rpx; box-sizing: border-box; animation: slideUp 0.3s ease-out; }
@keyframes slideUp { from { transform: translateY(50rpx); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
.modal-header { font-size: 32rpx; font-weight: bold; text-align: center; margin-bottom: 30rpx; color: #333; }
.post-textarea { width: 100%; height: 150rpx; background: #f5f7fa; border-radius: 16rpx; padding: 20rpx; font-size: 28rpx; box-sizing: border-box; margin-bottom: 30rpx; }
.submit-btn { background: #07c160; color: #fff; border-radius: 40rpx; font-weight: bold; font-size: 30rpx; }
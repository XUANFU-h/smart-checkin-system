page { height: 100vh; overflow: hidden; background-color: #f5f7fa; }

.pending-page {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  height: 100vh; padding: 0 10%; box-sizing: border-box; text-align: center;
}

.icon-wrapper {
  position: relative; width: 240rpx; height: 240rpx; border-radius: 50%;
  background: #e8e8e8; box-shadow: 20rpx 20rpx 60rpx #c5c5c5, -20rpx -20rpx 60rpx #ffffff;
  display: flex; justify-content: center; align-items: center; margin-bottom: 60rpx;
  overflow: hidden;
}

.radar-img { width: 140rpx; height: 140rpx; z-index: 2; }

/* 扫描雷达动画 */
.radar-scan {
  position: absolute; width: 100%; height: 100%; top: 0; left: 0;
  background: conic-gradient(from 0deg, transparent 70%, rgba(7, 193, 96, 0.4) 100%);
  border-radius: 50%; animation: spin 2s linear infinite; z-index: 1;
}

.title { font-size: 40rpx; font-weight: bold; color: #2c3e50; margin-bottom: 24rpx; }
.desc { font-size: 26rpx; color: #7f8c8d; line-height: 1.6; display: flex; flex-direction: column; margin-bottom: 80rpx; }

.back-btn {
  width: 100%; height: 96rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 48rpx; border: 4rpx solid rgba(0,0,0,0.08); background: #e8e8e8;
  box-shadow: 12rpx 12rpx 24rpx #c5c5c5, -12rpx -12rpx 24rpx #ffffff;
  color: #7f8c8d; font-size: 30rpx; font-weight: bold; transition: all 0.2s;
}
.back-btn:active { box-shadow: inset 12rpx 12rpx 24rpx #c5c5c5, inset -12rpx -12rpx 24rpx #ffffff; }

@keyframes spin { 100% { transform: rotate(360deg); } }
/* 页面底色完全对齐 H5 */
page { 
  background-color: #f5f7fa; 
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.profile-page { 
  padding: 48rpx 32rpx; 
  min-height: 100vh; 
  box-sizing: border-box; 
}

/* 核心修复：纯白卡片加弥散阴影，告别透明乱入 */
.glass-card { 
  background: #ffffff; 
  border-radius: 24rpx; 
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.04); 
  overflow: hidden;
}

/* 顶部名片区 */
.user-header { margin-bottom: 40rpx; margin-top: 30rpx; }
.user-header-inner { padding: 44rpx 36rpx; }
.user-base-info { display: flex; align-items: center; gap: 30rpx; }

.avatar { width: 136rpx; height: 136rpx; border-radius: 50%; border: 6rpx solid #fff; box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.08); object-fit: cover; }
.info-content { flex: 1; }
.nickname { font-size: 38rpx; font-weight: 900; color: #2c3e50; margin-bottom: 10rpx; display: flex; align-items: center; gap: 16rpx; }

/* 身份标签 */
.user-type-tag { font-size: 20rpx; padding: 4rpx 16rpx; border-radius: 12rpx; font-weight: bold; color: #fff; }
.tag-cadre { background: linear-gradient(135deg, #ff4757, #ff6b81); }
.tag-beta { background: linear-gradient(135deg, #ffa502, #ff7f50); }
.tag-official { background: linear-gradient(135deg, #1e90ff, #70a1ff); }

.student-id { font-size: 26rpx; color: #888; }
.edit-arrow { color: #ccc; font-weight: 300; font-family: monospace; font-size: 32rpx; }

.divider-line { height: 2rpx; background: rgba(0,0,0,0.04); margin: 40rpx 0; }

/* 赛道区 */
.track-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.section-label { font-size: 28rpx; font-weight: 800; color: #333; }
.modify-track-btn { background: rgba(0,0,0,0.04); padding: 10rpx 20rpx; border-radius: 16rpx; font-size: 24rpx; color: #666; display: flex; align-items: center; line-height: 1;}
.track-tags { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20rpx; }
.track-tag { background: rgba(7, 193, 96, 0.08); border: 2rpx solid rgba(7, 193, 96, 0.15); color: #07c160; padding: 24rpx 12rpx; border-radius: 16rpx; font-size: 26rpx; font-weight: 800; display: flex; justify-content: center; align-items: center; }
.empty-track-tip { font-size: 26rpx; color: #bbb; font-style: italic; }

/* 分数面板 */
.score-panel { display: flex; gap: 30rpx; margin-bottom: 40rpx; }
.score-box-wrapper { flex: 1; }
.score-box-inner { text-align: center; padding: 40rpx 0; }
.score-label { font-size: 26rpx; font-weight: 800; color: #777; margin-bottom: 10rpx; }
.score-val { font-size: 72rpx; font-weight: 900; line-height: 1.1; }
.score-tip { font-size: 20rpx; color: #bbb; margin-top: 10rpx; }
.emp-color { color: #E6A23C; }
.moral-color { color: #07c160; }

/* 底部菜单 */
.menu-list { margin-bottom: 40rpx; }
.menu-list-inner { padding: 10rpx 36rpx; }
.menu-item { display: flex; align-items: center; padding: 40rpx 0; border-bottom: 2rpx solid rgba(0,0,0,0.04); }
.menu-item.no-border { border-bottom: none; }
.menu-icon { font-size: 36rpx; margin-right: 16rpx; }
.menu-text { flex: 1; font-size: 30rpx; font-weight: 800; color: #333; }
.arrow { color: #ccc; font-weight: 300; font-family: monospace; font-size: 32rpx; }

/* 版权与留白 */
.footer-copyright { text-align: center; margin: 80rpx 0 40rpx; color: #ccc; font-size: 22rpx; line-height: 1.7; }
.bottom-spacer { height: 200rpx; }

/* ================= 模态框区 ================= */
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 2000; display: flex; align-items: center; justify-content: center; padding: 40rpx; opacity: 0; pointer-events: none; transition: opacity 0.3s ease; box-sizing: border-box; }
.modal-mask.show { opacity: 1; pointer-events: auto; }
.log-modal-card { width: 100%; max-width: 720rpx; transform: scale(0.95); transition: transform 0.3s ease; background: #fff; border-radius: 30rpx; }
.log-modal-card.pop-up { transform: scale(1); }
.modal-inner-pad { padding: 50rpx; }
.modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30rpx; }
.modal-title { font-size: 36rpx; font-weight: 900; color: #333; }
.header-appeal { font-size: 26rpx; color: #07c160; font-weight: bold; }
.total-display { font-size: 96rpx; font-weight: 900; text-align: center; margin-bottom: 30rpx; }
.log-scroll { max-height: 600rpx; }
.empty-tip { text-align: center; color: #999; font-size: 28rpx; padding: 40rpx 0; }
.log-item { background: #fafafa; border: 2rpx solid rgba(0,0,0,0.03); border-radius: 24rpx; padding: 28rpx; margin-bottom: 20rpx; }
.log-top { display: flex; justify-content: space-between; margin-bottom: 16rpx; }
.log-index { font-size: 28rpx; font-weight: bold; color: #333;}
.log-score { font-weight: 900; font-size: 34rpx; }
.score-add { color: #07c160; }
.score-sub { color: #ff4757; }
.log-detail { font-size: 26rpx; color: #666; margin-bottom: 6rpx; line-height: 1.4; }
.text-gray { color: #999; }
.log-time { font-size: 22rpx; color: #bbb; text-align: right; margin-top: 16rpx; }

.btn-primary { background: #07c160; color: #fff; border-radius: 50rpx; font-weight: bold; font-size: 32rpx; display: flex; align-items: center; justify-content: center; height: 88rpx; margin-top: 40rpx; }
page {
  background-color: #0f1015;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.container {
  padding: 40rpx 30rpx;
  min-height: 100vh; /* 💯 修复：将非标准的 min-h 改写为合规的 min-height */
  box-sizing: border-box;
}

/* 液态毛玻璃悬浮拟物防盘样式 */
.box-glass {
  background: rgba(255, 255, 255, 0.04) !important;
  backdrop-filter: blur(25px) saturate(190%);
  -webkit-backdrop-filter: blur(25px) saturate(190%);
  border: 2rpx solid rgba(255, 255, 255, 0.08) !important;
  box-shadow: 0 30rpx 60rpx rgba(0, 0, 0, 0.4), inset 0 4rpx 10rpx rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
}

/* 拦截遮罩样式 */
.binding-mask {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 100rpx;
  text-align: center;
}

.lock-icon { font-size: 110rpx; margin-bottom: 30rpx; animation: pulse 2s infinite; }
.bind-title { font-size: 40rpx; font-weight: 900; letter-spacing: 2rpx; margin-bottom: 20rpx; color: #ff4757; }
.bind-desc { font-size: 26rpx; color: #a4b0be; line-height: 1.6; padding: 0 40rpx; margin-bottom: 50rpx; }

.form-group { width: 100%; padding: 40rpx; box-sizing: border-box; margin-bottom: 40rpx; }
.scan-btn { background: rgba(52, 152, 219, 0.15); border: 2rpx dashed #3498db; color: #3498db; font-size: 28rpx; font-weight: bold; border-radius: 16rpx; padding: 20rpx 0; margin-bottom: 30rpx; }
.key-input { background: rgba(0, 0, 0, 0.3); border-radius: 16rpx; height: 90rpx; padding: 0 30rpx; text-align: left; font-size: 28rpx; color: #fff; border: 1rpx solid rgba(255,255,255,0.05); font-family: monospace; /* 💯 修复：将非标准的 font-mono 改写为合规的 font-family: monospace */ }

.submit-lock-btn { background: linear-gradient(135deg, #2ed573, #1ed14c); color: #fff; width: 100% !important; font-weight: bold; border-radius: 50rpx; height: 100rpx; display: flex; justify-content: center; align-items: center; box-shadow: 0 16rpx 32rpx rgba(46, 213, 115, 0.25); }

/* 主特权大盘样式 */
.panel-header { margin-bottom: 40rpx; padding-left: 10rpx; }
.admin-badge { background: linear-gradient(90deg, #ffa502, #ff7f50); color: #000; font-size: 18rpx; font-weight: 900; padding: 4rpx 12rpx; border-radius: 6rpx; display: inline-block; letter-spacing: 2rpx; margin-bottom: 10rpx; }
.panel-title { font-size: 44rpx; font-weight: 900; letter-spacing: 1rpx; }

.card { padding: 40rpx 30rpx; margin-bottom: 30rpx; box-sizing: border-box; }
.card-label { font-size: 24rpx; color: #a4b0be; font-weight: bold; margin-bottom: 30rpx; letter-spacing: 1rpx; display: block; }

.text-center { text-align: center; }
.totp-display { font-size: 72rpx; font-weight: 900; font-family: 'Courier New', Courier, monospace; color: #2ed573; letter-spacing: 6rpx; text-shadow: 0 0 20rpx rgba(46,213,115,0.2); margin-bottom: 25rpx; }

.progress-bar { background: rgba(0,0,0,0.4); height: 8rpx; border-radius: 10rpx; overflow: hidden; margin-bottom: 20rpx; }
.progress-inner { height: 100%; transition: width 1s linear; }
.countdown-tips { font-size: 22rpx; color: #747d8c; }

.kick-form { display: flex; gap: 20rpx; }
.kick-input { flex: 1; background: rgba(0,0,0,0.3); border-radius: 16rpx; height: 90rpx; padding: 0 30rpx; font-size: 28rpx; border: 1rpx solid rgba(255,255,255,0.05); color: #ff4757; font-weight: bold; }
.kick-btn { background: #ff4757; color: #fff; font-size: 28rpx; font-weight: bold; width: 180rpx !important; border-radius: 16rpx; display: flex; justify-content: center; align-items: center; box-shadow: 0 10rpx 20rpx rgba(255,71,87,0.2); }

.stats-grid { display: flex; justify-content: space-around; padding: 20rpx 0; border-bottom: 1rpx solid rgba(255,255,255,0.05); margin-bottom: 30rpx; /* 💯 修复：将非标准的 border-b 改写为合规的 border-bottom */ }
.grid-item { text-align: center; }
.grid-val { font-size: 52rpx; font-weight: 900; font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif; color: #ffa502; }
.grid-txt { font-size: 20rpx; color: #747d8c; margin-top: 6rpx; }

.ai-toggle-row { display: flex; justify-content: space-between; align-items: center; padding-top: 10rpx; }
.ai-txt-group { flex: 1; padding-right: 30rpx; }
.ai-title { font-size: 26rpx; font-weight: bold; color: #fff; }
.ai-desc { font-size: 20rpx; color: #747d8c; margin-top: 4rpx; line-height: 1.4; }

.progress-normal { background-color: #2ed573 !important; }
.progress-danger { background-color: #ff4757 !important; }

@keyframes pulse {
  0% { transform: scale(1); opacity: 0.9; }
  50% { transform: scale(1.05); opacity: 1; text-shadow: 0 0 30rpx rgba(255,71,87,0.4); }
  100% { transform: scale(1); opacity: 0.9; }
}

/* 📊 赛道直方图样式 */
.track-chart-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.chart-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.chart-name {
  font-size: 24rpx;
  color: #fff;
  font-weight: bold;
  width: 140rpx;
  text-align: left;
}
.chart-bar-container {
  flex: 1;
  background: rgba(0, 0, 0, 0.4);
  height: 20rpx;
  border-radius: 10rpx;
  overflow: hidden;
  margin: 0 20rpx;
}
.chart-bar {
  height: 100%;
  border-radius: 10rpx;
  transition: width 0.8s ease-in-out;
}
.chart-val {
  font-size: 22rpx;
  color: #a4b0be;
  font-weight: bold;
  width: 150rpx;
  text-align: right;
}

/* 按钮系列 */
.scan-login-btn {
  background: linear-gradient(135deg, #1e90ff, #00bfff) !important;
  color: #fff !important;
  font-weight: bold;
  border-radius: 16rpx;
  height: 90rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 10rpx 20rpx rgba(30, 144, 255, 0.2);
  width: 100% !important;
}

.logout-web-btn {
  background: linear-gradient(135deg, #ff4757, #ff6b81) !important;
  color: #fff !important;
  font-weight: bold;
  border-radius: 16rpx;
  height: 90rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 10rpx 20rpx rgba(255, 71, 87, 0.25);
  width: 100% !important;
}
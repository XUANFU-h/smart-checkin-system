page { background-color: var(--bg-color); color: var(--text-color); padding: 30rpx; box-sizing: border-box; }
.page-title { font-size: 40rpx; font-weight: bold; margin-bottom: 30rpx; font-family: 'KaiTi', serif;}

.glass-effect {
  background: var(--glass-bg); backdrop-filter: blur(20px); border: 1px solid var(--glass-border);
  box-shadow: 0 10px 30px var(--glass-shadow); border-radius: 20rpx; padding: 30rpx; margin-bottom: 40rpx;
  overflow: hidden; /* 防止底部条溢出 */
}
.section-title { font-size: 32rpx; font-weight: bold; color: #07c160; margin-bottom: 20rpx; }

/* 榜单滚动区 */
.leaderboard-scroll { height: 350rpx; margin-bottom: 80rpx; } /* 留出底部空间 */
.lb-item { display: flex; justify-content: space-between; align-items: center; padding: 15rpx 0; border-bottom: 1px dashed rgba(255,255,255,0.05);}
.lb-left { display: flex; align-items: center; }
.lb-rank { width: 50rpx; font-size: 28rpx; font-weight: bold; color: var(--text-muted); font-style: italic;}
.lb-rank.top-rank { color: #FFC107; font-size: 32rpx;} /* 前三名金色 */
.lb-name { color: var(--text-color); font-weight: bold; margin-right: 20rpx; width: 100rpx;}
.lb-class { color: var(--text-muted); font-size: 24rpx; background: rgba(255,255,255,0.05); padding: 4rpx 10rpx; border-radius: 8rpx;}
.lb-score { color: #E6A23C; font-weight: bold; font-size: 28rpx;}
.empty-text { text-align: center; color: var(--text-muted); font-size: 26rpx; margin-top: 40rpx;}

/* 底部悬浮排名 */
.my-rank-bar {
  position: absolute; bottom: 0; left: 0; width: 100%; padding: 20rpx 30rpx; box-sizing: border-box;
  background: rgba(7, 193, 96, 0.15); border-top: 1px solid rgba(7, 193, 96, 0.3);
  display: flex; justify-content: space-between; font-size: 26rpx; font-weight: bold;
}
.my-rank-bar.class-theme { background: rgba(64, 158, 255, 0.15); border-top-color: rgba(64, 158, 255, 0.3); }
.highlight { color: #fff; font-size: 30rpx;}

/* 足迹卡片操作栏 */
.record-card { padding: 30rpx; position: relative;}
.record-header { display: flex; justify-content: space-between; margin-bottom: 15rpx; font-size: 24rpx; color: var(--text-muted);}
.score { color: #E6A23C; font-weight: bold; background: rgba(230,162,60,0.1); padding: 4rpx 12rpx; border-radius: 10rpx;}
.pending-score { color: #909399; background: rgba(144,147,153,0.1); }
.record-content { font-size: 28rpx; line-height: 1.5; margin-bottom: 30rpx; background: var(--input-bg); padding: 20rpx; border-radius: 12rpx;}

.record-actions { display: flex; align-items: center; gap: 15rpx; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 20rpx;}
.flex-spacer { flex: 1; }
.action-btn { font-size: 24rpx; color: var(--text-color); background: rgba(255,255,255,0.05); padding: 10rpx 20rpx; border-radius: 30rpx; border: 1px solid var(--glass-border);}
.edit-btn { color: #409EFF; border-color: rgba(64,158,255,0.3); background: rgba(64,158,255,0.1);}
/* 【新增】删除按钮样式 */
.delete-btn { color: #F56C6C; border-color: rgba(245,108,108,0.3); background: rgba(245,108,108,0.1);}
.appeal-btn { color: #E6A23C; border-color: rgba(230,162,60,0.3); }

/* 评价模态框 */
.modal-mask { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 1000; opacity: 0; pointer-events: none; transition: 0.3s; display: flex; justify-content: center; align-items: center;}
.modal-mask.show { opacity: 1; pointer-events: auto; }
.modal-content { width: 85%; padding: 40rpx; }
.modal-header { text-align: center; font-size: 36rpx; font-weight: bold; margin-bottom: 40rpx; color: #fff;}
.comment-block { margin-bottom: 30rpx; }
.comment-label { font-size: 26rpx; margin-bottom: 10rpx; font-weight: bold;}
.ai-label { color: #07c160; }
.admin-label { color: #E6A23C; }
.self-label { color: #409EFF; }
.comment-val { font-size: 26rpx; color: #ddd; background: rgba(0,0,0,0.3); padding: 15rpx; border-radius: 10rpx;}
.self-textarea { width: 100%; height: 120rpx; background: rgba(0,0,0,0.3); border: 1px solid rgba(64,158,255,0.3); border-radius: 10rpx; padding: 15rpx; font-size: 26rpx; color: #fff; box-sizing: border-box;}
.save-btn { background: #07c160; color: #fff; border-radius: 40rpx; font-size: 30rpx; margin-top: 40rpx;}
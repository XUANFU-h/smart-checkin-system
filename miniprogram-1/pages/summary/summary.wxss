page { background-color: #0f1015; color: #fff; height: 100vh; overflow: hidden; }
.container { height: 100vh; position: relative; }
.summary-swiper { height: 100vh; width: 100vw; }

.page-content { height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 60rpx; box-sizing: border-box; text-align: center; position: relative;}
.title { font-size: 60rpx; font-weight: bold; color: #07c160; margin-bottom: 40rpx; letter-spacing: 10rpx; }
.text { font-size: 32rpx; line-height: 2; margin-bottom: 20rpx; color: #ccc; }
.highlight { color: #E6A23C; font-weight: bold; font-size: 36rpx; margin-top: 20rpx; }
.italic { font-style: italic; color: #888; margin-top: 30rpx; }

.memory-img { width: 100%; height: 500rpx; border-radius: 20rpx; margin: 40rpx 0; border: 4rpx solid rgba(255,255,255,0.1); box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.5); }
.date-tag { font-size: 40rpx; font-weight: bold; color: #409EFF; }

/* 音乐按钮与旋转动画 */
.music-btn { position: fixed; top: 100rpx; right: 40rpx; width: 80rpx; height: 80rpx; background: rgba(255,255,255,0.1); border-radius: 50%; display: flex; justify-content: center; align-items: center; z-index: 999; font-size: 40rpx; backdrop-filter: blur(10px); }
.rotating { animation: spin 3s linear infinite; }
@keyframes spin { 100% { transform: rotate(360deg); } }

/* 箭头提示 */
.arrow-down { position: absolute; bottom: 80rpx; font-size: 24rpx; color: #666; animation: bounce 1.5s infinite; }
@keyframes bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(15rpx); } }

/* 最终清算页样式 */
.warning-box { background: rgba(245, 108, 108, 0.1); border: 1px solid rgba(245, 108, 108, 0.3); padding: 30rpx; border-radius: 16rpx; margin-bottom: 40rpx; width: 100%; box-sizing: border-box;}
.warning-title { color: #F56C6C; font-size: 30rpx; font-weight: bold; margin-bottom: 15rpx; }
.warning-desc { color: #ccc; font-size: 24rpx; line-height: 1.6; text-align: justify; }

.score-board { display: flex; width: 100%; justify-content: space-around; margin-bottom: 40rpx; }
.score-item { display: flex; flex-direction: column; align-items: center; }
.score-val { font-size: 60rpx; font-weight: bold; margin-top: 10rpx; }
.emp { color: #E6A23C; } .moral { color: #07c160; }

.shop-box { width: 100%; background: rgba(255,255,255,0.02); padding: 30rpx; border-radius: 20rpx; box-sizing: border-box;}
.shop-title { font-size: 32rpx; font-weight: bold; color: #fff; margin-bottom: 20rpx; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10rpx; }
.goods-list { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.goods-item { background: rgba(0,0,0,0.3); padding: 20rpx; border-radius: 12rpx; border: 1px solid rgba(255,255,255,0.05); }
.g-name { color: #fff; font-size: 28rpx; font-weight: bold; text-align: left;}
.g-cost { color: #E6A23C; font-size: 22rpx; margin-top: 10rpx; text-align: left;}

.end-text { position: absolute; bottom: 40rpx; font-size: 20rpx; color: #555; letter-spacing: 2rpx; }
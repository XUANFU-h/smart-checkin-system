<view class="nav-wrapper">

<view class="global-notice-mask" wx:if="{{showNotice}}">
  <view class="global-notice-box glass-effect">
    <view class="notice-icon">📢</view>
    <view class="notice-title">{{globalNotice.title}}</view>
    <scroll-view scroll-y="true" class="notice-content">{{globalNotice.content}}</scroll-view>
    <button class="notice-btn" bindtap="closeNotice">我知道了</button>
  </view>
</view>

<view class="global-notice-mask" wx:if="{{showGift && !showNotice}}">
  <view class="global-notice-box glass-effect">
    <view class="notice-icon">🎁</view>
    <view class="notice-title" style="color: #E6A23C;">驿站专属福利</view>

    <scroll-view scroll-y="true" class="notice-content" style="max-height: 450rpx; margin-bottom: 30rpx;">
      <block wx:for="{{shopGifts}}" wx:key="id">
        <view style="background: rgba(255,255,255,0.6); padding: 20rpx; margin-bottom: 20rpx; border-radius: 16rpx; border: 1px solid rgba(0,0,0,0.05);">
          <view style="text-align: center; font-weight: bold; font-size: 32rpx; color: #333;">{{item.name}}</view>
          <view style="text-align: center; color: {{item.empCost === 0 || item.emp_cost === 0 ? '#07c160' : '#F56C6C'}}; font-size: 24rpx; margin-top: 10rpx; font-weight: bold;">
            {{item.empCost === 0 || item.emp_cost === 0 ? '✨ 免费派发中' : '🔥 限时抢购中'}}
          </view>
        </view>
      </block>
    </scroll-view>

    <view class="btn-group">
      <button class="notice-btn cancel" bindtap="closeGifts">忽略</button>
      <button class="notice-btn confirm" bindtap="goToShopFromGifts">前往驿站</button>
    </view>
  </view>
</view>

<view class="nav-capsule glass-effect">
  <view class="nav-item {{selected === 0 ? 'selected' : ''}}" hover-class="nav-item-active" bindtap="switchTab" data-path="/pages/home/home" data-index="0">
    <image class="icon" src="/assets/zhuye.svg" mode="aspectFit"></image>
  </view>

  <view class="nav-item {{selected === 1 ? 'selected' : ''}}" hover-class="nav-item-active" bindtap="switchTab" data-path="/pages/workshop/workshop" data-index="1">
    <image class="icon" src="/assets/youxi.svg" mode="aspectFit"></image>
  </view>

  <view class="nav-item {{selected === 2 ? 'selected' : ''}}" hover-class="nav-item-active" bindtap="switchTab" data-path="/pages/profile/profile" data-index="2">
    <image class="icon" src="/assets/wode.svg" mode="aspectFit"></image>
  </view>
</view>

<view class="action-circle glass-effect {{selected === 3 ? 'selected-circle' : ''}}" hover-class="action-circle-active" bindtap="handleCheckinTap" data-path="/pages/checkin/checkin" data-index="3">
  <image class="icon-large" src="/assets/daka.svg" mode="aspectFit"></image>
</view>

</view>
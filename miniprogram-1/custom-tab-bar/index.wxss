:host {
  position: fixed; bottom: 0; left: 0; width: 100%;
  pointer-events: none; 
  display: flex; justify-content: center;
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
  z-index: 9999;
}

.nav-wrapper { pointer-events: auto; display: flex; align-items: center; gap: 40rpx; } 

.glass-effect {
  background: rgba(255, 255, 255, 0.35);
  backdrop-filter: blur(30px) saturate(180%);
  -webkit-backdrop-filter: blur(30px) saturate(180%);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  box-shadow:
          0 20rpx 40rpx rgba(0, 0, 0, 0.05),
          inset 0 10rpx 20rpx rgba(255, 255, 255, 0.8),
          inset 0 -4rpx 12rpx rgba(255, 255, 255, 0.3);
  transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.nav-capsule { display: flex; align-items: center; padding: 20rpx 40rpx; border-radius: 100rpx; gap: 30rpx; }
.nav-item { width: 95rpx; height: 95rpx; display: flex; justify-content: center; align-items: center; border-radius: 50%; transition: all 0.3s ease; }
.nav-item .icon { width: 55rpx; height: 55rpx; opacity: 0.9; }

.nav-item.selected { background: rgba(0, 0, 0, 0.04); box-shadow: inset 0 4rpx 10rpx rgba(0, 0, 0, 0.05); }
.nav-item-active { background: rgba(0, 0, 0, 0.08) !important; transform: scale(0.9) !important; }

.action-circle { width: 140rpx; height: 140rpx; display: flex; justify-content: center; align-items: center; border-radius: 50%; margin: 0; padding: 0; flex-shrink: 0; }
.action-circle .icon-large { width: 70rpx; height: 70rpx; }

.selected-circle { background: rgba(0, 0, 0, 0.04); }
.action-circle-active { transform: scale(0.95); background: rgba(0, 0, 0, 0.08) !important; box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.1), inset 0 4rpx 10rpx rgba(255, 255, 255, 0.5) !important; }

.global-notice-mask { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.6); z-index: 10000; display: flex; justify-content: center; align-items: center; pointer-events: auto;}
.global-notice-box { width: 80%; background: rgba(232,232,232,0.9); border-radius: 30rpx; padding: 50rpx 40rpx; text-align: center; box-shadow: 20rpx 20rpx 50rpx rgba(0,0,0,0.3); position: relative; border: 2rpx solid rgba(255,255,255,0.4);}
.notice-icon { font-size: 80rpx; margin-bottom: 20rpx;}
.notice-title { font-size: 36rpx; font-weight: 900; color: #d00; margin-bottom: 30rpx;}
.notice-content { max-height: 400rpx; font-size: 30rpx; color: #333; line-height: 1.6; text-align: justify; margin-bottom: 40rpx;}
.notice-btn { background: #07c160; color: #fff; font-weight: bold; border-radius: 50rpx; width: 80%; box-shadow: 0 8rpx 16rpx rgba(7,193,96,0.3);}

.btn-group { display: flex; gap: 20rpx; justify-content: center; }
.btn-group .cancel { background: #ccc; color: #333; box-shadow: none; flex: 1;}
.btn-group .confirm { flex: 1; }